POSTGRES_DB=mtg_deck_builder
POSTGRES_USER=mtg
POSTGRES_PASSWORD=mtg
DATABASE_URL=postgresql+psycopg://mtg:mtg@postgres:5432/mtg_deck_builder
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173
VITE_API_BASE_URL=http://localhost:8000
SCRYFALL_API_BASE_URL=https://api.scryfall.com
EMBEDDING_DIMENSIONS=384
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_PATH=data/embedding-cache.sqlite3
EMBEDDING_MODEL_CACHE_PATH=data/fastembed-cache
RAG_INGEST_BATCH_SIZE=100
RAG_INGEST_BATCH_DELAY_SECONDS=0
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
AGENT_PROVIDER=openai
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
LOG_LEVEL=INFO
LOG_FORMAT=plain
